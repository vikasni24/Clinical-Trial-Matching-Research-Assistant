MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=clinical_trial_matching
SYNTHEA_FHIR_DIR=data/synthea/fhir
TRIALS_DATA_PATH=data/trials/dev_trials.json

# LLM provider — required only for the Research Assistant's actual
# generation step; everything else (patients, evidence, trial matching,
# audit) works without it. Never commit a real key; leave LLM_API_KEY
# unset to run everything else without it.
#
# LLM_PROVIDER selects which concrete provider get_llm_provider() builds:
#   "anthropic" (default) — expects an Anthropic key (sk-ant-...)
#   "groq"                — expects a Groq key (gsk_...)
# LLM_MODEL is optional for either — each provider falls back to its own
# sensible default (Anthropic: claude-haiku-4-5-20251001; Groq:
# llama-3.3-70b-versatile) when left unset.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30.0

# CORS (Frontend Phase 1) — origins allowed to call this API from a
# browser. Defaults to Vite's dev server ports; only override if the
# frontend runs elsewhere. Must be a JSON array, e.g.:
# CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

